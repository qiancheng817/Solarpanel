<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!--
        网页容器。它整体会被顶栏高度往下推一段（translationY），
        所以网页顶部不会被顶栏挡住；顶栏收起时这段位移归零，
        可视区域立刻变大，而且不需要让 WebView 重新布局（不会造成网页回流抖动）。
    -->
    <FrameLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!--
        顶栏：覆盖在网页之上，下滑自动收起、上滑自动出现。
        注意：这里刻意不用 elevation —— FrameLayout 会按 Z 值排序绘制子视图，
        一旦顶栏有海拔，它就会盖到下面的配置页 / 错误页之上。
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_blue_dark"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/brand_blue_dark"
            app:menu="@menu/main_menu"
            app:subtitleTextColor="#CFE4F1"
            app:title="@string/app_name"
            app:titleTextColor="@color/white" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/brand_blue"
            android:visibility="gone" />

        <!-- 顶栏下沿的细分隔线，网页内容从下面滚过时层次更清楚 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="64dp"
            android:paddingRight="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_title"
                android:textAppearance="@style/TextAppearance.Solarpanel.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/setup_subtitle"
                android:textAppearance="@style/TextAppearance.Solarpanel.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/serverInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:helperText="@string/setup_helper"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serverInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/setup_button"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.55"
            android:contentDescription="@string/err_title"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/err_title"
            android:textAppearance="@style/TextAppearance.Solarpanel.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/err_detail"
            android:textAppearance="@style/TextAppearance.Solarpanel.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:text="@string/err_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorChangeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/err_change" />

    </LinearLayout>

</FrameLayout>
